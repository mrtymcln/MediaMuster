+{
+	QTest::addColumn<int>("start");
+	QTest::addColumn<int>("length");
+	QTest::addColumn<char>("file");
+	QTest::newRow("beginning-after-two-sequence-offsets") << 30 << 3 << 'B';
+	QTest::newRow("inside-after-two-sequence-offsets") << 33 << 5 << 'C';
+	QTest::newRow("end-after-two-sequence-offsets") << 38 << 2 << 'D';
+}
+
+void TestMediaEngineAvbReferences::relativeTrackAccumulatesSequenceOffsets()
+{
+	QFETCH(int, start);
+	QFETCH(int, length);
+	QFETCH(char, file);
+	auto s = proxyTrackGraph(1, -1);
+	// TRKR is inside TKFX track 0 after 10 units; that effect is on the
+	// containing composition's slot 1 after another 20 units. Scope 1/-1
+	// reaches slot 0, with both offsets added to both requested endpoints.
+	replaceField(s, 3, QStringLiteral("SourceClip.start_time"), qint32(start));
+	replaceField(s, 3, QStringLiteral("Clip.length"), quint32(length));
+	replaceField(s, 2, QStringLiteral("TrackGroup.length"), qint32(length));
+	replaceField(s, 4, QStringLiteral("TrackGroup.length"), qint32(40));
+	replaceField(s, 6, QStringLiteral("Clip.length"), quint32(10));
+	timedClip(s, 21, identity('A'), 0, 30);
+	timedClip(s, 22, identity('B'), 0, 3);
+	timedClip(s, 23, identity('C'), 0, 5);
+	timedClip(s, 24, identity('D'), 0, 2);
+	fileSource(s, 1020, 'C');
+	fileSource(s, 1030, 'D');
+	sequence(s, 20, {21, 22, 23, 24});
+	field(s, 20, QStringLiteral("Component.media_kind_id"), pictureKind);
+	replaceComponent(s, 4, 0, 20);
+	filler(s, 25, 20);
+	filler(s, 26, 10);
+	sequence(s, 31, {26, 6});
+	add(s, 30, "TKFX");
+	replaceField(s, 30, QStringLiteral("TrackGroup.length"), qint32(20));
+	track(s, 30, 0, 900, 31);
+	sequence(s, 7, {25, 30});
+	field(s, 7, QStringLiteral("Component.media_kind_id"), pictureKind);
+	replaceComponent(s, 4, 1, 7);
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(result.coverageComplete);
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity(file)});
+}
+
+void TestMediaEngineAvbReferences::relativeProxyCycleTerminates()
+{
+	auto s = proxyTrackGraph(0, 0);
+	independentProxyControl(s);
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(!result.coverageComplete);
+	QVERIFY(!result.issues.isEmpty());
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity('D')});
+	QVERIFY(result.edges.size() < 50);
+}
