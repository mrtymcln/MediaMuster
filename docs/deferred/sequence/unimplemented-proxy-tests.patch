+void TestMediaEngineAvbReferences::relativeTrackUncertainty_data()
+{
+	QTest::addColumn<QString>("damage");
+	for (const auto *damage : {"negative-scope", "scope-beyond-root", "slot-before-list", "slot-after-list",
+							  "kind-mismatch", "rate-mismatch", "target-component-missing", "relative-offset-missing"})
+		QTest::newRow(damage) << QString::fromLatin1(damage);
+}
+
+void TestMediaEngineAvbReferences::relativeTrackUncertainty()
+{
+	QFETCH(QString, damage);
+	auto s = proxyTrackGraph();
+	independentProxyControl(s);
+	if (damage == QLatin1String("negative-scope"))
+		replaceField(s, 6, QStringLiteral("TrackRef.relative_scope"), qint16(-1));
+	else if (damage == QLatin1String("scope-beyond-root"))
+		replaceField(s, 6, QStringLiteral("TrackRef.relative_scope"), qint16(1));
+	else if (damage == QLatin1String("slot-before-list"))
+		replaceField(s, 6, QStringLiteral("TrackRef.relative_track"), qint16(-2));
+	else if (damage == QLatin1String("slot-after-list"))
+		replaceField(s, 6, QStringLiteral("TrackRef.relative_track"), qint16(2));
+	else if (damage == QLatin1String("kind-mismatch"))
+		replaceField(s, 10, QStringLiteral("Component.media_kind_id"), audioKind);
+	else if (damage == QLatin1String("rate-mismatch"))
+		replaceField(s, 10, QStringLiteral("Component.edit_rate.mantissa"), qint32(50));
+	else if (damage == QLatin1String("target-component-missing"))
+	{
+		removeField(s, 4, QStringLiteral("TrackGroup.tracks[0].component"));
+		s->relationships.removeIf([](const auto &edge)
+								 { return edge.origin == 4 && edge.locator.name == QLatin1String("TrackGroup.tracks[0].component"); });
+	}
+	else if (damage == QLatin1String("relative-offset-missing"))
+		removeField(s, 6, QStringLiteral("TrackRef.relative_track"));
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(!result.coverageComplete);
+	QVERIFY(!result.issues.isEmpty());
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity('D')});
+}
+
+void TestMediaEngineAvbReferences::sourceMobJumpResetsRelativeScope()
+{
+	auto s = proxyTrackGraph(1, -1);
+	independentProxyControl(s);
+	// Caller O has an unrequested Z track. The target M's scope must start
+	// afresh; TRKR cannot climb back into O and borrow that otherwise hidden Z.
+	composition(s, 14, identity('O'), 2);
+	clip(s, 13, identity('M'), 77);
+	clip(s, 15, identity('Z'));
+	track(s, 14, 0, 500, 15);
+	track(s, 14, 1, 77, 13);
+	fileSource(s, 1030, 'Z');
+	replaceField(s, 3, QStringLiteral("SourceClip.mob_id"), identity('O'));
+	for (auto &edge : s->relationships)
+		if (edge.origin == 3 && edge.locator.name == QLatin1String("SourceClip.mob_id"))
+			edge.recordedReference = identity('O');
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(!result.coverageComplete);
+	QVERIFY(!result.issues.isEmpty());
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity('D')});
+	QVERIFY(!hasEdge(result, 14, 15));
+}
