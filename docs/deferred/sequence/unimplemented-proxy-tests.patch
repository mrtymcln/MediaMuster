+void TestMediaEngineAvbReferences::fillerProxySelectsRelativeSlot_data()
+{
+	QTest::addColumn<int>("offset");
+	QTest::addColumn<char>("file");
+	QTest::newRow("previous-slot-not-track-label") << -1 << 'A';
+	QTest::newRow("next-slot-not-track-label") << 1 << 'B';
+}
+
+void TestMediaEngineAvbReferences::fillerProxySelectsRelativeSlot()
+{
+	QFETCH(int, offset);
+	QFETCH(char, file);
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(proxyTrackGraph(0, qint16(offset)), cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(result.coverageComplete);
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity(file)});
+	QVERIFY(hasEdge(result, 4, file == 'A' ? 10 : 11));
+}
+
+void TestMediaEngineAvbReferences::spareProxyDoesNotReplaceRealComponent()
+{
+	auto s = proxyTrackGraph();
+	clip(s, 7, identity('B'));
+	replaceComponent(s, 4, 1, 7);
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(result.coverageComplete);
+	QCOMPARE(mediaIds(result), QSet<QByteArray>{identity('B')});
+	QVERIFY(!hasEdge(result, 4, 6));
+}
+
+void TestMediaEngineAvbReferences::zeroLengthFillerDoesNotActivateProxy()
+{
+	auto s = proxyTrackGraph();
+	replaceField(s, 5, QStringLiteral("Clip.length"), quint32(0));
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(result.coverageComplete);
+	QVERIFY(result.mediaReferences.isEmpty());
+	QVERIFY(!hasEdge(result, 4, 6));
+}
+
+void TestMediaEngineAvbReferences::sharedProxyKeepsCallerOwnership()
+{
+	auto s = proxyTrackGraph();
+	composition(s, 14, identity('N'), 2);
+	clip(s, 13, identity('N'), 77);
+	clip(s, 15, identity('B'));
+	clip(s, 16, identity('A'));
+	track(s, 14, 0, 500, 15);
+	track(s, 14, 1, 77, 5);
+	track(s, 14, 2, 8, 16);
+	fillerProxy(s, 14, 1, 6);
+	track(s, 2, 1, 2, 13);
+	// Both paths reach the same FILL and TRKR at the same local time. Only
+	// their containing composition differs, and each resolves its own neighbour.
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({2}), cancel);
+	QVERIFY(result.coverageComplete);
+	QCOMPARE(mediaIds(result), (QSet<QByteArray>{identity('A'), identity('B')}));
+	QVERIFY(hasEdge(result, 4, 10) && hasEdge(result, 14, 15));
+	QCOMPARE(result.mediaReferences.size(), 2);
+}
