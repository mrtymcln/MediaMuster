+void TestAvbParser::nested_excerpt_selects_used_camera_angles()
+{
+	QFETCH(bool, big);
+	QFETCH(int, sourceStart);
+	QFETCH(int, length);
+	QFETCH(QByteArray, expectedAngles);
+	QTemporaryDir tmp;
+	QVERIFY(tmp.isValid());
+	TestAvb::Document document;
+	document.bigEndian = big;
+	document.objects = {
+		{"ABIN", {}}, {"CMPO", {}}, {"CMPO", {}},
+		{"SEQU", TestAvb::sequence(big, {5, 6})},
+		{"SLCT", TestAvb::selector(big, {7, 8, 9}, 0, 50)},
+		{"SLCT", TestAvb::selector(big, {7, 8, 9}, 1, 50)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('A'), true, 1, 1, 50, 0)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('B'), true, 1, 1, 50, 0)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('C'), true, 1, 1, 50, 0)}};
+	appendTimelineFiles(document, "ABC");
+	finishTimelineExcerpt(document, 4, 100, sourceStart, quint32(length));
+	const auto result = AvbBinLoader::load(TestAvb::write(tmp.filePath("nested-camera-excerpt.avb"), document.bytes()));
+	QVERIFY2(result.usable, qPrintable(result.error));
+	QVERIFY(result.sourceGraph && result.referenceResult);
+	QCOMPARE(result.sourceGraph->outcome, MediaEngine::ParsedSource::Outcome::Complete);
+	QVERIFY2(result.coverageComplete, qPrintable(result.warnings.join(';')));
+	QCOMPARE(decoded(result, 5, QStringLiteral("Selector.selected")).toInt(), 0);
+	QCOMPARE(decoded(result, 6, QStringLiteral("Selector.selected")).toInt(), 1);
+	QSet<QString> expected;
+	for (const auto angle : expectedAngles)
+		expected.insert(MobId::format(timelineId(angle)));
+	QCOMPARE(result.mediaFileIds.fullIds, expected);
+	QVERIFY(result.mediaFileIds.legacyKeys.isEmpty());
+	QCOMPARE(result.referenceResult->mediaReferences.size(), expected.size());
+	MediaEngine::Cancellation cancellation;
+	const auto selected = MediaEngine::AvbReferenceIndex(result.sourceGraph, cancellation).resolveReferences(
+		{MediaEngine::AvbSelection::Kind::SelectedSequences, {2}}, cancellation);
+	QVERIFY(selected.coverageComplete);
+	QCOMPARE(resolvedFileIds(selected), expected);
+	// Camera C is present in both groups, but is never used in the edit.
+	QVERIFY(!result.mediaFileIds.fullIds.contains(MobId::format(timelineId('C'))));
+}
