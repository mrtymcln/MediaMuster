+		field(s, 12, prefix + QStringLiteral(".offset.denominator"), qint32(1));
+		field(s, 12, prefix + QStringLiteral(".timescale"), qint32(1));
+		field(s, 12, prefix + QStringLiteral(".pp_count"), qint16(0));
