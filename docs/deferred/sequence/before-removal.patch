+	field(s, 10, QStringLiteral("ParameterList.count"), qint32(1));
+	add(s, 11, "PRIT");
+	field(s, 11, QStringLiteral("ParameterItem.enable"), true);
+	edge(s, 2, 10, QStringLiteral("Component.param_list"));
+	edge(s, 10, 11, QStringLiteral("ParameterList.items[0]"));
+	add(s, 12, "PRCL");
+	field(s, 12, QStringLiteral("ParamClip.interp_kind"), qint32(1));
+	field(s, 12, QStringLiteral("ParamClip.value_type"), qint16(valueType));
+	field(s, 12, QStringLiteral("ParamClip.point_count"), qint32(2));
+	edge(s, 11, 12, QStringLiteral("ParameterItem.control_track"));
+	for (const auto &name : {QStringLiteral("Component.left_bob"), QStringLiteral("Component.right_bob"),
+							 QStringLiteral("Component.attributes"), QStringLiteral("Component.session_attrs"),
+							 QStringLiteral("Component.param_list")})
+		edge(s, 12, 0, name);
+	for (int point = 0; point < 2; ++point)
+	{
+		const auto prefix = QStringLiteral("ParamClip.control_points[%1]").arg(point);
