+			static std::optional<qint64> scale(qint64 value, qint64 numerator, qint64 denominator, bool ceil, bool exact)
+			{
+				if (value < 0 || value / denominator > std::numeric_limits<qint64>::max() / numerator ||
+					value % denominator > std::numeric_limits<qint64>::max() / numerator)
+					return {};
+				const auto whole = (value / denominator) * numerator;
+				const auto remainder = (value % denominator) * numerator;
+				if (exact && remainder % denominator)
+					return {};
+				qint64 result = 0;
+				if (!addTime(whole, remainder / denominator, result) ||
+					(ceil && remainder % denominator && !addTime(result, 1, result)))
+					return {};
+				return result;
+			}
+
+			static std::optional<QPair<qint64, qint64>> rateRatio(const AvidObject &from, const AvidObject &to)
+			{
+				const auto a = rate(from);
+				const auto b = rate(to);
+				if (!a || !b)
+					return {};
+				auto numerator = b->first;
+				auto denominator = a->first;
+				const auto divisor = std::gcd(numerator, denominator);
+				numerator /= divisor;
+				denominator /= divisor;
+				const auto difference = b->second - a->second;
+				if (difference < -40 || difference > 40)
+					return {};
+				for (qint64 i = 0; i < qAbs(difference); ++i)
+				{
+					auto &multiply = difference > 0 ? numerator : denominator;
+					auto &divide = difference > 0 ? denominator : numerator;
+					const auto cancel = std::gcd(divide, qint64(10));
+					divide /= cancel;
+					const auto factor = 10 / cancel;
+					if (multiply > std::numeric_limits<qint64>::max() / factor)
+						return {};
+					multiply *= factor;
+				}
+				return qMakePair(numerator, denominator);
+			}
