+void TestAvbParser::transition_overlap_keeps_neighbors_and_render()
+{
+	QFETCH(bool, big);
+	QFETCH(int, sourceStart);
+	QFETCH(QByteArray, expectedMedia);
+	QTemporaryDir tmp;
+	QVERIFY(tmp.isValid());
+	TestAvb::Document document;
+	document.bigEndian = big;
+	document.objects = {
+		{"ABIN", {}}, {"CMPO", {}}, {"CMPO", {}},
+		{"SEQU", TestAvb::sequence(big, {5, 6, 7})},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('A'), true, 1, 1, 50, 0)},
+		{"TNFX", TestAvb::transition(big, 10, 4, 8)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('B'), true, 1, 1, 50, 0)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('R'), true, 1, 1, 10, 0)}};
+	appendTimelineFiles(document, "ABR");
+	// Both full input windows overlap at [40,50); 50+50-10 is 90 counts.
+	finishTimelineExcerpt(document, 4, 90, sourceStart, 5);
+	const auto result = AvbBinLoader::load(TestAvb::write(tmp.filePath("transition-excerpt.avb"), document.bytes()));
+	QVERIFY2(result.usable, qPrintable(result.error));
+	QVERIFY(result.sourceGraph && result.referenceResult);
+	QCOMPARE(result.sourceGraph->outcome, MediaEngine::ParsedSource::Outcome::Complete);
+	QVERIFY2(result.coverageComplete, qPrintable(result.warnings.join(';')));
+	QCOMPARE(decoded(result, 6, QStringLiteral("TrackGroup.length")).toInt(), 10);
+	QCOMPARE(decoded(result, 6, QStringLiteral("TransitionEffect.cutpoint")).toInt(), 4);
+	QSet<QString> expected;
+	for (const auto media : expectedMedia)
+		expected.insert(MobId::format(timelineId(media)));
+	QCOMPARE(result.mediaFileIds.fullIds, expected);
+	QCOMPARE(result.referenceResult->mediaReferences.size(), expected.size());
+	MediaEngine::Cancellation cancellation;
+	const auto selected = MediaEngine::AvbReferenceIndex(result.sourceGraph, cancellation).resolveReferences(
+		{MediaEngine::AvbSelection::Kind::SelectedSequences, {2}}, cancellation);
+	QVERIFY(selected.coverageComplete);
+	QCOMPARE(resolvedFileIds(selected), expected);
+}
