+void TestMediaEngineAvbReferences::compositionRateUsesFloorAndCeil()
+{
+	auto s = cameraTimeline({0, 1, 2});
+	// A 50-unit composition contains a 25-unit track. Its [19,21) request
+	// reaches track units [9,11), spanning the A/B cut at unit 10.
+	replaceField(s, 2, QStringLiteral("Component.edit_rate.mantissa"), qint32(50));
+	replaceField(s, 2, QStringLiteral("TrackGroup.length"), qint32(60));
+	outerExcerpt(s, 19, 2);
+	for (const auto handle : {ObjectHandle(4), ObjectHandle(5)})
+		replaceField(s, handle, QStringLiteral("Component.edit_rate.mantissa"), qint32(50));
+	// The source jump lands directly in a 50-unit child composition; its
+	// ordinary composition-to-track descent then performs floor/ceil mapping.
+	// A direct SourceClip jump to the 25-unit track would require an unproved
+	// fractional source-position conversion instead.
+	composition(s, 6, identity('M'), 2);
+	replaceField(s, 6, QStringLiteral("Component.edit_rate.mantissa"), qint32(50));
+	replaceField(s, 6, QStringLiteral("TrackGroup.length"), qint32(60));
+	track(s, 6, 0, 1, 2);
+	replaceField(s, 5, QStringLiteral("SourceClip.mob_id"), identity('M'));
+	for (auto &reference : s->relationships)
+		if (reference.origin == 5 && reference.locator.name == QLatin1String("SourceClip.mob_id"))
+			reference.recordedReference = identity('M');
+	Cancellation cancel;
+	const auto result = AvbReferenceIndex(s, cancel).resolveReferences(selected({4}), cancel);
+	QVERIFY(result.coverageComplete);
+	QCOMPARE(mediaIds(result), (QSet<QByteArray>{identity('A'), identity('B')}));
+	QVERIFY(!hasEdge(result, 3, 12));
+}
