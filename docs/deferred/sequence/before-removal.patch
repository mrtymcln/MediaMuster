+
+void TestAvbParser::constant_motion_maps_nested_excerpt()
+{
+	QFETCH(bool, big);
+	QFETCH(int, numerator);
+	QFETCH(bool, independentBranch);
+	QFETCH(QByteArray, expectedMedia);
+	QFETCH(bool, complete);
+	QTemporaryDir tmp;
+	QVERIFY(tmp.isValid());
+	TestAvb::Document document;
+	document.bigEndian = big;
+	document.objects = {
+		{"ABIN", {}}, {"CMPO", {}}, {"CMPO", {}},
+		{"SPED", TestAvb::motion(big, 5, 80, numerator)},
+		{"SEQU", TestAvb::sequence(big, {6, 7})},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('A'), true, 1, 1, 20, 0)},
+		{"SCLP", TestAvb::sourceClip(big, timelineId('B'), true, 1, 1, 20, 0)}};
+	appendTimelineFiles(document, "ABC");
+	// The output excerpt [20,40) maps to input [10,20) forwards and
+	// [20,30) in reverse. The authored input changes from A to B at 20.
+	finishTimelineExcerpt(document, 4, 80, 20, 20, independentBranch);
+	const auto result = AvbBinLoader::load(TestAvb::write(tmp.filePath("motion-excerpt.avb"), document.bytes()));
+	QVERIFY2(result.usable, qPrintable(result.error));
+	QVERIFY(result.sourceGraph && result.referenceResult);
+	QCOMPARE(result.sourceGraph->outcome, MediaEngine::ParsedSource::Outcome::Complete);
+	QCOMPARE(result.coverageComplete, complete);
+	QCOMPARE(decoded(result, 4, QStringLiteral("MotionEffect.speed_ratio.numerator")).toInt(), numerator);
+	QCOMPARE(decoded(result, 4, QStringLiteral("MotionEffect.speed_ratio.denominator")).toInt(), 1);
+	QSet<QString> expected;
+	for (const auto media : expectedMedia)
+		expected.insert(MobId::format(timelineId(media)));
+	QCOMPARE(result.mediaFileIds.fullIds, expected);
+	QCOMPARE(result.referenceResult->mediaReferences.size(), expected.size());
+	QCOMPARE(result.warnings.isEmpty(), complete);
+	MediaEngine::Cancellation cancellation;
+	const auto selected = MediaEngine::AvbReferenceIndex(result.sourceGraph, cancellation).resolveReferences(
+		{MediaEngine::AvbSelection::Kind::SelectedSequences, {2}}, cancellation);
+	QCOMPARE(selected.coverageComplete, complete);
+	QCOMPARE(resolvedFileIds(selected), expected);
+	if (!complete)
+		QVERIFY(!selected.issues.isEmpty());
+}
