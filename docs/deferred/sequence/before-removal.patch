+			bool noActiveMapping(const AvidObject &value) const
+			{
+				if (!value.avb || !value.avb->interpretationComplete)
+					return false;
+				for (const auto &name : {QStringLiteral("Component.param_list"), QStringLiteral("MotionEffect.source_param_list")})
+				{
+					const auto recorded = std::any_of(value.properties.cbegin(), value.properties.cend(), [&](const auto &field)
+						{ return field.locator.name == name; });
+					if (!recorded)
+						continue; // Absent optional extension in a completely read object.
+					const auto reference = integer(value, name);
+					if (!reference || *reference < 0)
+						return false;
+					if (!*reference)
+						continue;
+					const auto *list = object(ObjectHandle(*reference));
+					const auto count = list ? integer(*list, QStringLiteral("ParameterList.count")) : std::nullopt;
+					if (!list || !list->avb || list->avb->classId != "PRLS" || !list->avb->interpretationComplete ||
+						!count || *count < 0 || *count > m_source.objects.size())
+						return false;
+					for (qint64 i = 0; i < *count; ++i)
+					{
+						const auto item = integer(*list, QStringLiteral("ParameterList.items[%1]").arg(i));
+						const auto *parameter = item && *item > 0 ? object(ObjectHandle(*item)) : nullptr;
+						if (!parameter || !parameter->avb || !parameter->avb->interpretationComplete ||
+							!numberIs(*parameter, QStringLiteral("ParameterItem.enable"), 0))
+							return false;
+					}
+				}
+				return true;
+			}
