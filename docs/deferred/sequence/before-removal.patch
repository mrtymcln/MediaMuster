+			static std::optional<QPair<qint64, qint64>> rate(const AvidObject &value)
+			{
+				auto mantissa = integer(value, QStringLiteral("Component.edit_rate.mantissa"));
+				auto exponent = integer(value, QStringLiteral("Component.edit_rate.exponent"));
+				if (!mantissa || *mantissa <= 0 || *mantissa > std::numeric_limits<qint32>::max() ||
+					!exponent || *exponent < std::numeric_limits<qint16>::min() || *exponent > std::numeric_limits<qint16>::max())
+					return {};
+				while (*mantissa % 10 == 0)
+				{
+					*mantissa /= 10;
+					if (*exponent == std::numeric_limits<qint64>::max())
+						return {};
+					++*exponent;
+				}
+				return qMakePair(*mantissa, *exponent);
+			}
