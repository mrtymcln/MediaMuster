  "probeSource": "#include \"mainwindow.h\"\n#include \"mediascanner.h\"\n#include \"mediatablemodel.h\"\n#include \"mediafilterproxy.h\"\n#include \"fileoperationcontroller.h\"\n#include \"avbbinloader.h\"\n#include \"mediacsv.h\"\n#include \"mediaengine/scanmodel.h\"\n#include <QApplication>\n#include <QElapsedTimer>\n#include <QEventLoop>\n#include <QFile>\n#include <QJsonArray>\n#include <QJsonDocument>\n#include <QJsonObject>\n#include <QTableView>\n#include <QTimer>\n#include <libproc.h>\n#include <sys/resource.h>\n#include <unistd.h>\n\nQJsonObject memory()\n{\n    rusage_info_v4 usage{};\n    rusage rss{};\n    const bool ok = proc_pid_rusage(getpid(), RUSAGE_INFO_V4,\n        reinterpret_cast<rusage_info_t *>(&usage)) == 0;\n    getrusage(RUSAGE_SELF, &rss);\n    return {{\"rusageV4Ok\",ok}, {\"residentBytes\",double(usage.ri_resident_size)},\n        {\"physicalFootprintBytes\",double(usage.ri_phys_footprint)},\n        {\"lifetimePeakPhysicalFootprintBytes\",double(usage.ri_lifetime_max_phys_footprint)},\n        {\"peakResidentBytes\",double(rss.ru_maxrss)}};\n}\nint main(int argc,char **argv)\n{\n    QApplication app(argc,argv);\n    app.setOrganizationName(\"CoplandVerification\");\n    app.setApplicationName(\"CoplandUiBaseline20261012\");\n    app.setQuitOnLastWindowClosed(false);\n    if (argc < 4) return 2;\n    const QString root=QString::fromLocal8Bit(argv[1]);\n    const QString binPath=QString::fromLocal8Bit(argv[2]);\n    const QString output=QString::fromLocal8Bit(argv[3]);\n    QJsonObject report{{\"root\",root},{\"binPath\",binPath},{\"qtVersion\",qVersion()},\n        {\"platform\",QGuiApplication::platformName()}};\n    QJsonArray stages;\n    auto record=[&](const QString &name,qint64 elapsed=0,int count=-1) {\n        QJsonObject r=memory();r[\"stage\"]=name;r[\"elapsedMs\"]=double(elapsed);\n        if(count>=0)r[\"rows\"]=count;\n        stages.append(r);\n    };\n    record(\"process-start\");\n    MainWindow window(nullptr,MainWindow::StartupMode::UiOnly);\n    window.show();\n    QApplication::processEvents();\n    window.grab();\n    auto *model=window.findChild<MediaTableModel *>();\n    auto *proxy=window.findChild<MediaFilterProxy *>();\n    auto *scanner=window.findChild<MediaScanner *>();\n    auto *ops=window.findChild<FileOperationController *>();\n    auto *table=window.findChild<QTableView *>();\n    if(!model||!proxy||!scanner||!ops||!table)return 3;\n    record(\"window-initialised\");\n    const QStringList roots{root};\n    if(!QMetaObject::invokeMethod(&window,\"onPathsDropped\",Qt::DirectConnection,Q_ARG(QStringList,roots)))return 4;\n    auto scan=[&](const QString &name) {\n        QEventLoop loop;\n        bool done=false,failed=false;\n        QMetaObject::invokeMethod(&window,\"onPathsDropped\",Qt::DirectConnection,Q_ARG(QStringList,roots));\n        QElapsedTimer timer; timer.start();\n        auto conn=QObject::connect(scanner,&MediaScanner::scanFinished,&window,\n            [&](const QVector<MediaFile> &) {done=true;loop.quit();},Qt::QueuedConnection);\n        auto fail=QObject::connect(scanner,&MediaScanner::scanFailed,&window,\n            [&](const QString &e){report[\"error\"]=e;failed=true;loop.quit();},Qt::QueuedConnection);\n        QTimer timeout; timeout.setSingleShot(true);\n        QObject::connect(&timeout,&QTimer::timeout,&loop,[&]{failed=true;scanner->cancelScan();loop.quit();});\n        timeout.start(60000);\n        QMetaObject::invokeMethod(&window,\"scanSelected\",Qt::DirectConnection);\n        if(ops->isIdle())return false;\n        loop.exec();\n        QObject::disconnect(conn);QObject::disconnect(fail);\n        if(!done||failed)return false;\n        QApplication::processEvents();\n        const auto pixmap=window.grab();\n        if(pixmap.isNull()||!ops->isIdle()||model->rowCount()!=proxy->rowCount())return false;\n        record(name,timer.elapsed(),model->rowCount());\n        return true;\n    };\n    if(!scan(\"scan-1-through-offscreen-paint\"))return 5;\n    const int firstCount=model->rowCount();\n    if(firstCount && model->fileAt(0).mediaEngineScan) {\n        const auto &session=*model->fileAt(0).mediaEngineScan;\n        report[\"actualScanRoots\"]=QJsonArray::fromStringList(session.request.roots);\n        QJsonObject sourceCounts;\n        for(const auto &source:session.sources) {\n            const QString key=QString::number(int(source.snapshot->source))+\":\"+QString::number(int(source.outcome));\n            sourceCounts[key]=sourceCounts[key].toInt()+1;\n        }\n        report[\"sourceKindOutcomeCounts\"]=sourceCounts;\n        report[\"scanComplete\"]=session.parsingComplete&&session.reconciliationComplete&&!session.cancelled;\n    }\n    qint64 totalBytes=0;for(const auto &row:model->allFiles())totalBytes+=row.sizeBytes;\n    report[\"totalPhysicalBytes\"]=double(totalBytes);\n    QWeakPointer<const MediaEngine::ScanResult> oldSession;\n    if(firstCount)oldSession=model->fileAt(0).mediaEngineScan;\n    QElapsedTimer timer;timer.start();\n    proxy->sort(int(MediaTableModel::Column::SizeMB),Qt::DescendingOrder);\n    QApplication::processEvents();window.grab();\n    record(\"sort-size\",timer.elapsed(),proxy->rowCount());\n    timer.restart();\n    QMetaObject::invokeMethod(&window,\"onSearchChanged\",Qt::DirectConnection,Q_ARG(QString,QString(\"Audio\")));\n    QApplication::processEvents();window.grab();\n    record(\"search-audio\",timer.elapsed(),proxy->rowCount());\n    QMetaObject::invokeMethod(&window,\"onSearchChanged\",Qt::DirectConnection,Q_ARG(QString,QString()));\n    QVector<MediaFile> snapshot;\n    snapshot.reserve(proxy->rowCount());\n    for(int i=0;i<proxy->rowCount();++i)snapshot.append(model->fileAt(proxy->mapToSource(proxy->index(i,0)).row()));\n    timer.restart();\n    const bool csvOk=MediaCsv::write(output+\".csv\",snapshot,{model->precomputesEnabled(),model->clipDurationEnabled()});\n    report[\"csvWritten\"]=csvOk;\n    record(\"csv-visible-frozen-rows\",timer.elapsed(),snapshot.size());\n    // Keep only one frozen export row; test ownership independently of allocator release.\n    snapshot=snapshot.isEmpty()?QVector<MediaFile>{}:QVector<MediaFile>{snapshot.first()};\n    timer.restart();\n    QVector<AvbBin> bins{AvbBinLoader::load(binPath)};\n    report[\"binUsable\"]=bins.first().isUsable();\n    report[\"binCompositionCount\"]=int(bins.first().compositions.size());\n    model->setAvbBins(bins);\n    AvbFilter filter;AvbFilter::Step step;\n    step.fileReferences=bins.first().mediaFileIds;\n    step.binDisplayNames.append(bins.first().displayName);\n    step.sourceGraphs.append(bins.first().sourceGraph);\n    step.referenceResults.append(bins.first().referenceResult);\n    filter.steps.append(step);proxy->setBinFilter(filter);\n    QApplication::processEvents();window.grab();\n    record(\"bin-load-model-apply-filter-paint\",timer.elapsed(),proxy->rowCount());\n    proxy->setBinFilter({});model->setAvbBins({});bins.clear();filter={};step={};\n    QApplication::processEvents();record(\"bin-references-released\",0,proxy->rowCount());\n    if(!scan(\"rescan-through-offscreen-paint\"))return 6;\n    report[\"sameRowCountAfterRescan\"]=model->rowCount()==firstCount;\n    auto retained=oldSession.toStrongRef();\n    report[\"oneFrozenRowPinsPriorSession\"]=!retained.isNull();\n    report[\"priorSessionPhysicalRowsWhilePinned\"]=retained?int(retained->files.size()):0;\n    retained.clear();snapshot.clear();\n    QApplication::processEvents();\n    report[\"priorSessionReleasedAfterSnapshotClear\"]=oldSession.isNull();\n    record(\"snapshot-released\",0,model->rowCount());\n    model->setMediaFiles({},AvbMetadataResolver::RowProjection::AlreadyApplied);QApplication::processEvents();record(\"table-cleared\");\n    report[\"stages\"]=stages;\n    QFile file(output); if(!file.open(QIODevice::WriteOnly))return 7;\n    file.write(QJsonDocument(report).toJson());\n    return csvOk?0:8;\n}\n",
  "limits": [
    "No proposed compact retention, source fallback, sequence membership or presentation behavior has been implemented or verified here.",
    "Offscreen paint is a synchronous rendering proxy, not native macOS visible-window/input latency. UiOnly bypasses normal constructor startup recovery/crash collection and automatic timer start, but current scan options and return-to-idle paths can still discover/poll volumes.",
    "CSV uses the same visible-row snapshot pattern and production writer synchronously; save/choice dialogs and asynchronous MainWindow dispatch were not exercised.",
    "Bin loading uses production loader/model/proxy directly, not the combined dialog. This bin matches zero rows in the copied 267-file inventory. Exact sequence/group membership and unloading bins that enriched matched rows are not established.",
    "Only one bin and 267 complete local media copies. No 300,000-file NEXIS, Windows, sustained-load, database-rich controlled app benchmark or enforced-memory-ceiling claim.",
    "An earlier exploratory Scan All run admitted mounted media plus these copies and overlapped the stalled Avid process; it is excluded from the accepted timing/memory summary. Initial harness attempts corrected sidebar re-selection and expected root normalization; these were not product fixes.",
    "Input media size/mtime remained unchanged and copied bin SHA256 remained unchanged throughout accepted trials. Read-only media paths and content fingerprint identify this exact corpus; no corpus-wide source-format conclusion."
