// Windows resources for MediaMuster. Configured by CMake into
// <build>/mediamuster-win.rc: the version number and copyright
live there, so they are never duplicated.
#pragma code_page(65001)
#include <windows.h>

IDI_ICON1 ICON "@MM_RC_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @MM_RC_VERSION_COMMA@
 PRODUCTVERSION  @MM_RC_VERSION_COMMA@
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Martin McLean"
            VALUE "FileDescription",  "@PROJECT_NAME@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@PROJECT_NAME@"
            VALUE "LegalCopyright",   "@MEDIAMUSTER_COPYRIGHT@"
            VALUE "OriginalFilename", "@PROJECT_NAME@.exe"
            VALUE "ProductName",      "@PROJECT_NAME@"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
