  "standard": "C++17",
  "qt": "6.5.3",
  "scope": "Only Bella PMR/MDB reader note consolidation, their focused tests and Bella documentation/evidence. Existing app/runtime integrations are unchanged.",
  "combinations": [
    {
      "case": "Own-file direct Project key conflict",
      "typicalNotesBefore": 2,
      "typicalNotesAfter": 1,
      "after": "Project names disagree; Project is left blank without substituting another value.",
      "context": "Same owner and actual _PJ/PROJNAME key. Public Conflict retained. Nested USER and linked-source reports remain separate."
    },
    {
      "case": "One unreadable own-file Project attribute list",
      "typicalNotesBefore": 3,
      "typicalNotesAfter": 1,
      "after": "Project attributes cannot be read; Project is left blank without substituting a linked record.",
      "context": "Owner plus OMFI:CPNT:Attributes. Conflicting pointer lists retain public Conflict and use the specific Project attributes conflict message; missing lists still follow the original rules. Independent key payload failures remain separate."
    },
    {
      "case": "Rejected PMR v16 and same-capture older-set fallback",
      "typicalNotesBefore": 2,
      "typicalNotesAfter": 1,
      "after": "[Original exact v16 rejection reason] Version 16 is unusable; trying the older set from the same capture.",
      "context": "Reason retains its record/offset detail and report retains source.path. Append fallback sentence only after all existing pre-fallback Cancel checks have allowed the attempt; Cancel before that keeps the rejection reason alone. Independent trailing-content and older-set rejection notes remain separate."
    },
    {
      "case": "WAVE zero storage width and resulting precision unavailability",
      "typicalNotesBefore": 2,
      "typicalNotesAfter": 1,
      "after": "Audio bit depth is unavailable because the recorded sample storage width is zero.",
      "context": "Descriptor object and Summary property retained. Independent sample-frequency/extension/subtype problems remain separate. Single-note early-return zero-width explanations are reworded consistently."
    },
    {
      "case": "Audio Summary framing failure before any complete format chunk",
      "typicalNotesBefore": 2,
      "typicalNotesAfter": 1,
      "after": "[Original exact incomplete chunk header or chunk-range reason] No complete required format chunk could be read before sound data.",
      "context": "Descriptor object and Summary property retained. Later framing damage keeps the original single framing note and qualified earlier values. Missing-format-only and incomplete-format-prefix problems remain distinct."
    }
  ],
  "preserved": [
    "All bounds, type, text, ownership and consistency checks.",
    "All returned metadata values, optional/variant state, public reading/check statuses and matching qualifications.",
    "Every existing Cancel checkpoint and source capture/check behavior.",
    "Public reader headers and MobId implementation.",
    "Full source path remains in the owning report; object/property/key detail remains in notes.",
    "OldScanner stays active; Bin Filter, progress, MediaFile/table, journal, Unfinished Business and Undo are unchanged."
  ],
  "implementationNotes": [
    "The private Project result retains the conflicted direct key for diagnostic context; public projectKey is still assigned only for successful selection.",
    "The already-checked owner list is passed into ownProject; an unreadable/conflicting own list emits one contextual cause-and-consequence note.",
    "Zero WAVE storage still follows every original encoding/precision check; only the duplicate precision note is omitted.",
    "Audio Summary framing failures return at the same unavailable-result boundary when no format has been found, avoiding a second consequence note."
  ],
