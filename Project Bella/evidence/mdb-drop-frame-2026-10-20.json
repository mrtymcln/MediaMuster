  "proposedBellaRule": {
    "firstResolveClock": "Use the already selected qualified Duration display clock. Supported NDF-only clocks such as24/25 need no DF lookup. Do not infer DF merely from29.97/59.94.",
    "association": "For DF-capable clocks, follow this physical file own essence SourceClip ID, SourceTrack/kind and position into explicitly linked source timecode; validate relevant timeline segment/range and clock. Accept a direct own-file timecode only when its layout/association is established. No generic recursive sweep of every reachable TCCP.",
    "limitedFirstRelease": "Support demonstrated simple direct/immediate source relationships and bounded segment spans; unresolved, unsupported or ambiguous mappings remain unavailable rather than guessed.",
    "legacyLayout": "Validate complete supported32-bit Flags scalar and object byte order, then extract bit0. Other bits are not themselves proven damage; do not require wholeword0/1.",
    "omf2Layout": "Separate typed one-byte Boolean Drop, valid0/1 only; do not reinterpret a malformed Boolean as false.",
    "compatibility": "Qualify TC FPS and timing/range against selected display clock. Initial DF modes are30000/1001 base30 and60000/1001 base60. Avid native supports a broader nominal predicate, not automatically broader Bella coverage.",
    "recordedTrue": "Use DF only when applicable and compatible.",
    "recordedFalse": "Use NDF when applicable.",
    "provenAbsent": "Recommend explicit NDF display fallback with absent status distinct from recorded false.",
    "irrelevant": "Clearly unrelated or different-clock TC does not participate; it cannot override or blank a known NDF-only Duration.",
    "unusableApplicable": "Where numbering mode is needed, unreadable or conflicting applicable metadata, unresolved association, or an incompatible purported DF mode leaves formatted Duration blank while independently valid Length/rate and file remain.",
    "missingVsDamaged": "An incomplete or broken reference lookup does not prove absence and cannot silently take the clean-absence fallback.",
    "zero": "Established zero can keep00:00:00:00 because numbering mode cannot change a zero length; original zero qualification remains separate from unavailable input.",
    "storage": "Compact selected numbering mode and shared availability/reason status; no permanent candidate graph or alternative-value history solely for DF.",
    "boundaries": "MDB-only Duration remains. Do not open/reuse media headers to repair Duration or its numbering. Do not add StartTC, replace Length, infer mode from rate, or change audio samples. Keep colon layout and >24hour display."
  },
  "currentDifference": "Current scanner recursively gathers Flags/Drop from source mobs, accepts whole0/1, and row toBool collapses unavailable into false. Existing test may linkDF to25fps without compatibility validation; carry over arithmetic/association facts selectively.",
  "primarySources": [
    {
      "url": "https://developer.avid.com/ctms/api/rs_common_object_properties.html",
      "role": "Public rate/count/timecode-duration separation."
    },
    {
      "url": "https://developer.avid.com/ctms/api/aa/resources/time-based.html",
      "role": "Specific public resource treats omitteddropFrame asfalse; policy precedent, not privateMDBdamage proof."
    },
    {
