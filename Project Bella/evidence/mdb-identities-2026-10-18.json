    "nativeMdbWrite": {
      "function": "omfiDualStream::WriteUID",
      "address": "0xb4c9c",
      "anchors": [
        "0xb4cdc..0xb4ce0: does not write a null modern identity.",
        "0xb4cf4 prepares the 12-byte form using ConvertToOmfiUid.",
        "0xb4d04..0xb4d10: selects the 12-byte output branch only when IsMediaComposerID is true and modern byte13 is zero; otherwise writes all32 bytes.",
