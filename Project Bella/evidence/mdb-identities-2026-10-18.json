    "nativeMdbRead": {
      "function": "omfiDualStream::ReadUID",
      "address": "0xb66e8",
      "anchors": [
        "0xb671c: initializes NullMobID.",
        "0xb6740: reads up to 32 property bytes.",
        "0xb6744..0xb6750: accepts returned widths 32 or 12; other widths leave the null result.",
        "0xb6770..0xb6778: copies all 32 bytes for a modern ID.",
        "0xb6798..0xb67e8: for a 12-byte UID, adjusts each of its three 32-bit words for the applicable metadata byte order, then calls ConvertFromOmfiUid at 0xb67f8.",
        "0xb6800..0xb6858: for a 32-byte ID, adjusts only material Data1 at byte16 (32 bits), Data2 at byte20 (16 bits) and Data3 at byte22 (16 bits). All other bytes stay unchanged.",
        "The swap condition is stream object-order != II and != zero. No prefix-family exception suppresses these swaps."
      ],
      "byteOrderSource": {
        "function": "omfiDualStream::LoadBentoObject",
        "address": "0xb2680",
        "anchors": [
          "0xb278c: clears the loaded-object order field at stream+0x1e0.",
          "0xb27a8..0xb2810: scans the loaded object for its ByteOrder property and stores it.",
          "0xb283c..0xb2844: when loading HEAD/object1, retains its order as the default at stream+0x1e2.",
          "0xb284c..0xb2850: an object without its own order uses the HEAD/default order.",
          "0xb2858..0xb2874: absence of any specified order enters an error path."
        ],
        "qualification": "The OMF object/HEAD metadata order is separate from the Bento table word order. Current genuine corpus files use II for both, so mixed/endian behavior here is native static evidence, not a genuine sample result."
      }
    },
    "legacyMapping": {
      "function": "ConvertFromOmfiUid",
      "address": "0x23675c",
      "input": "Three decoded 32-bit words: organization, high, low.",
      "output": {
        "prefix16Hex": "060a2b340101010101010f0013000000",
        "materialData1": "high",
        "materialData2": "low & 0xffff",
        "materialData3": "low >> 16",
        "suffix8Hex": "060e2b347f7f2a80",
        "canonicalLittleEndianBytes": "prefix16 + littleEndian32(high) + littleEndian32(low) + suffix8"
      },
      "anchors": [
        "0x23675c shifts input x0 right32, extracting the second word. The first word is never tested or copied.",
        "0x23676c..0x236784 stores the constant Avid prefix.",
        "0x236788..0x236790 stores the high word and the two halves of the low word.",
        "0x236794..0x23679c stores the fixed suffix."
      ],
      "criticalLimit": "This current native helper unconditionally discards the organization word, including a non42 value. Its existence does not establish an information-preserving mapping for every OMF producer.",
