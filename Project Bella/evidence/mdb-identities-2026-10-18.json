      },
      "legacy": {
        "function": "Read_OMFMobID",
        "address": "0x2359b4",
        "layout": "Two32-bit values, high then low. Both are read through the endian-aware stream scalar reader before building the same Avid wrapper.",
        "anchors": [
          "0x235a0c..0x235a20 reads high via ReadInt32.",
          "0x235a24..0x235a3c reads low via ReadInt32.",
          "0x235a48..0x235a78 stores prefix, normalized material and suffix."
        ],
        "important": "An eight-byte legacy PMR ID uses two32-bit source words, not three words and not a source4/2/2 layout."
      },
      "modern": {
        "function": "Read_AAFMobID",
        "address": "0x235bf0",
        "layout": "12 label bytes; four separate length/instance bytes; material Data1(32), Data2(16), Data3(16); eight Data4 bytes.",
        "anchors": [
          "0x235c48..0x235c60 reads the12-byte label as bytes.",
          "0x235c64..0x235cd0 reads four individual bytes.",
          "0x235cd4..0x235d24 reads scalar4/2/2 material fields.",
          "0x235d28..0x235d50 reads the eight-byte tail unchanged."
        ],
        "important": "Normalize only the numeric4/2/2 fields for source endianness. Do not reverse the entire ID or exempt the known Avid wrapper family."
      },
      "scalarEvidence": [
        "AvidCore AStream::ReadUInt32 at0x27054 uses the swap flag and rev32 at0x270a8.",
        "AvidCore AFileStream::ReadInt32 at0xbdf84 uses the same swap flag and rev32 at0xbdfd8.",
        "Equivalent16-bit scalar readers use the matching16-bit conversion."
      ]
