  "sources": [
    {
      "path": "/Users/martymclean/Developer/MediaMuster/docs/reviews/2026-10-03-format-audit/evidence/omfspec21.pdf",
      "sha256": "62dd18226aee3fda27c4ac25cf50ab1764b7776d4a42eac8f00d3e5b07909794",
      "citations": [
        {
          "printed_page": 164,
          "pdf_page": 176,
          "heading": "Media Data Class (MDAT)",
          "finding": "Private classes containing digital media with associated SourceMob should subclass MDAT; OMFI:MDAT:MobID identifies describing source; HEAD indexes all MediaData; each has corresponding SourceMob with same MobID. Complete page text extracted and visually rendered/inspected."
        },
        {
          "printed_page": 152,
          "pdf_page": 164,
          "heading": "Header Class (HEAD)",
          "finding": "OMFI:HEAD:MediaData is the set of all media-data objects; OMFI:HEAD:Mobs is all defined Mobs."
        },
        {
          "printed_page": 237,
          "pdf_page": 249,
          "heading": "Changed Properties",
          "finding": "OMF2 removes ObjectSpine and replaces traversal with HEAD mob/media indexes; indexes become object-reference arrays."
        }
      ]
    },
    {
      "path": "/private/tmp/omf-review-omFile.c",
      "sha256": "ddeb8da392f4e41688db3e9824b729281fadce6a78e4152b2f33a5dd18e1201f",
      "upstream_reference": "https://github.com/LWKS-Software/omfkt22/blob/main/kitomfi/omFile.c",
      "citations": [
        {
          "lines": "352-353",
          "finding": "MDAT registered as private for revision1."
        },
        {
          "lines": "374-377",
          "finding": "IDAT registers as MDAT subclass in either revision."
        },
        {
          "lines": "758-765",
          "finding": "OMF1 MediaData is optional MobIndex; ObjectSpine required ObjRefArray."
        },
        {
          "lines": "783-784",
          "finding": "OMF2 HEAD MediaData is required ObjRefArray."
        },
        {
          "lines": "831-832",
          "finding": "MDAT MobID required UID in either revision."
        },
        {
          "lines": "2819-2843",
          "finding": "Media cache enumerates recorded HEAD MediaData. OMF2 reads MDAT MobID; OMF1 uses MobIndex ID/object pair. No MPEG-specific registration appears in this retained core source."
        }
      ]
    }
  ],
